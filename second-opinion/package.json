{
  "name": "second-opinion",
  "private": true,
  "scripts": {
    "setup": "cd backend && python3 -m pip install -r requirements.txt && cd ../frontend && npm install",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && python3 -m uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
